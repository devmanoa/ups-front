# URL publique du backend UPS (projet ups-backend)
VITE_API_URL=http://localhost:3000

# === Keycloak (plateforme Konitys) ===
# Laisser VITE_KEYCLOAK_URL vide désactive l'authentification : pratique en
# développement local isolé, à ne pas faire en production.
VITE_KEYCLOAK_URL=https://keycloak.orkessi.com
VITE_KEYCLOAK_REALM=konitys
VITE_KEYCLOAK_CLIENT_ID=ups-management

# URL du host plateforme Konitys exposant HeaderBar/Sidebar via Module
# Federation. Si vide ou injoignable, l'app utilise ses Topbar/Sidebar
# locaux (visuellement identiques).
VITE_PLATEFORM_URL=

# === Google Places (autocomplétion d'adresse) ===
# Clé Google Maps avec l'API "Places" activée et la facturation configurée.
# Cette clé est visible dans le navigateur : restreignez-la impérativement
# par domaine (HTTP referrers) dans la console Google Cloud.
# Si elle est absente, les champs d'adresse restent en saisie manuelle.
VITE_GOOGLE_MAPS_API_KEY=

# En production (Coolify), ces variables sont injectées au démarrage du
# conteneur : les modifier ne demande pas de reconstruire l'image.
