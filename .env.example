# URL publique du backend UPS (projet ups-backend)
#
# Développement local :
#   VITE_API_URL=http://localhost:3000
#
# Production (Coolify) : définissez cette variable dans les Environment Variables
# de la ressource. Elle est injectée au démarrage du conteneur — aucun rebuild
# n'est nécessaire pour la modifier.
#   VITE_API_URL=https://api-ups.mondomaine.fr
VITE_API_URL=http://localhost:3000
